<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>OfficeWard — Business Dashboard</title>

<meta name="description" content="OfficeWard customer dashboard">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --bg: #070a10;
    --sidebar: #090d15;
    --panel: #0d121c;
    --panel-2: #101722;
    --border: rgba(255,255,255,.08);
    --border-hover: rgba(255,255,255,.14);

    --text: #f5f7fb;
    --muted: #8993a5;
    --muted-2: #5e6879;

    --blue: #3d8cff;
    --blue-bright: #69a7ff;
    --blue-soft: rgba(61,140,255,.12);

    --green: #36d98b;
    --yellow: #f2c94c;
    --red: #ff5f67;

    --radius: 14px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Manrope", sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}

/* =========================
   APP SHELL
========================= */

.app {
    min-height: 100vh;
    display: flex;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
    width: 255px;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    position: fixed;
    inset: 0 auto 0 0;
    display: flex;
    flex-direction: column;
    z-index: 100;
}

.brand {
    height: 76px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 22px;
    border-bottom: 1px solid var(--border);
}

.logo-mark {
    width: 34px;
    height: 34px;
    border: 2px solid var(--blue);
    border-radius: 50%;
    position: relative;
    box-shadow: 0 0 18px rgba(61,140,255,.18);
}

.logo-mark::after {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    background: var(--blue);
    border-radius: 50%;
    top: 3px;
    right: -2px;
    box-shadow: 0 0 12px var(--blue);
}

.brand-text {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: .08em;
}

.nav {
    padding: 22px 12px;
    flex: 1;
}

.nav-label {
    font-family: "IBM Plex Mono", monospace;
    color: var(--muted-2);
    font-size: 10px;
    letter-spacing: .14em;
    padding: 0 12px 10px;
}

.nav-item {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 9px;
    margin-bottom: 3px;
    text-align: left;
    transition: .2s ease;
}

.nav-item:hover {
    color: var(--text);
    background: rgba(255,255,255,.035);
}

.nav-item.active {
    color: var(--text);
    background: var(--blue-soft);
}

.nav-icon {
    width: 19px;
    text-align: center;
    font-size: 15px;
}

.nav-item.active .nav-icon {
    color: var(--blue-bright);
}

.sidebar-bottom {
    padding: 14px;
    border-top: 1px solid var(--border);
}

.status-card {
    padding: 13px;
    border: 1px solid rgba(54,217,139,.18);
    background: rgba(54,217,139,.045);
    border-radius: 10px;
    margin-bottom: 12px;
}

.status-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
}

.status-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(54,217,139,.7);
}

.status-sub {
    font-size: 10px;
    color: var(--muted);
    margin-top: 6px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
}

.avatar {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: var(--panel-2);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 800;
}

.profile-info {
    flex: 1;
    min-width: 0;
}

.profile-name {
    font-size: 12px;
    font-weight: 700;
}

.profile-business {
    font-size: 10px;
    color: var(--muted);
    margin-top: 2px;
}

/* =========================
   MAIN
========================= */

.main {
    margin-left: 255px;
    width: calc(100% - 255px);
    min-height: 100vh;
}

.topbar {
    height: 76px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
    background: rgba(7,10,16,.85);
    backdrop-filter: blur(16px);
    position: sticky;
    top: 0;
    z-index: 50;
}

.page-title {
    font-size: 18px;
    font-weight: 800;
}

.page-subtitle {
    color: var(--muted);
    font-size: 11px;
    margin-top: 3px;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.icon-button {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--muted);
    transition: .2s ease;
}

.icon-button:hover {
    color: var(--text);
    border-color: var(--border-hover);
}

.content {
    padding: 30px 32px 50px;
    max-width: 1500px;
}

/* =========================
   VIEWS
========================= */

.view {
    display: none;
}

.view.active {
    display: block;
}

/* =========================
   DASHBOARD HERO
========================= */

.welcome {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 25px;
}

.welcome h1 {
    font-size: clamp(25px, 3vw, 36px);
    letter-spacing: -.035em;
}

.welcome p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 7px;
}

.date-label {
    color: var(--muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
}

/* =========================
   METRICS
========================= */

.metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 13px;
    margin-bottom: 20px;
}

.metric {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: .2s ease;
}

.metric:hover {
    border-color: var(--border-hover);
    transform: translateY(-1px);
}

.metric-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.metric-label {
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
}

.metric-icon {
    width: 29px;
    height: 29px;
    border-radius: 7px;
    background: var(--blue-soft);
    display: grid;
    place-items: center;
    color: var(--blue-bright);
    font-size: 12px;
}

.metric-value {
    font-size: 28px;
    font-weight: 800;
    margin-top: 15px;
    letter-spacing: -.04em;
}

.metric-change {
    margin-top: 5px;
    font-size: 10px;
    color: var(--green);
}

/* =========================
   GRID
========================= */

.dashboard-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 15px;
}

.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
}

.panel-head {
    min-height: 61px;
    padding: 0 19px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.panel-title {
    font-size: 13px;
    font-weight: 800;
}

.panel-link {
    border: 0;
    background: transparent;
    color: var(--blue-bright);
    font-size: 10px;
    font-weight: 700;
}

.panel-body {
    padding: 18px;
}

/* =========================
   APPOINTMENTS
========================= */

.appointment {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,.055);
}

.appointment:last-child {
    border-bottom: 0;
}

.time {
    width: 55px;
    font-family: "IBM Plex Mono", monospace;
    color: var(--muted);
    font-size: 10px;
}

.customer-avatar {
    width: 35px;
    height: 35px;
    border-radius: 9px;
    background: #141b27;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 800;
}

.appt-info {
    flex: 1;
}

.appt-name {
    font-size: 12px;
    font-weight: 700;
}

.appt-service {
    color: var(--muted);
    font-size: 10px;
    margin-top: 3px;
}

.badge {
    padding: 5px 8px;
    border-radius: 6px;
    font-size: 9px;
    font-weight: 700;
}

.badge.confirmed {
    background: rgba(54,217,139,.08);
    color: var(--green);
}

.badge.pending {
    background: rgba(242,201,76,.08);
    color: var(--yellow);
}

/* =========================
   ACTIVITY
========================= */

.activity {
    display: flex;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,.055);
}

.activity:last-child {
    border-bottom: 0;
}

.activity-icon {
    width: 31px;
    height: 31px;
    border-radius: 8px;
    background: var(--blue-soft);
    color: var(--blue-bright);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-size: 11px;
}

.activity-text {
    font-size: 11px;
    line-height: 1.45;
}

.activity-time {
    color: var(--muted-2);
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    margin-top: 3px;
}

/* =========================
   AI EMPLOYEE PANEL
========================= */

.employee-card {
    margin-top: 15px;
    padding: 19px;
    border: 1px solid rgba(61,140,255,.17);
    background:
        radial-gradient(circle at 90% 0%, rgba(61,140,255,.12), transparent 40%),
        var(--panel);
    border-radius: var(--radius);
}

.employee-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.employee-title {
    display: flex;
    align-items: center;
    gap: 11px;
}

.employee-icon {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--blue-soft);
    color: var(--blue-bright);
    display: grid;
    place-items: center;
    font-size: 18px;
}

.employee-name {
    font-size: 13px;
    font-weight: 800;
}

.employee-role {
    font-size: 10px;
    color: var(--muted);
    margin-top: 3px;
}

.online {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--green);
    font-size: 10px;
    font-weight: 700;
}

.employee-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 18px;
}

.employee-stat {
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.05);
    padding: 12px;
    border-radius: 8px;
}

.employee-stat-value {
    font-size: 17px;
    font-weight: 800;
}

.employee-stat-label {
    color: var(--muted);
    font-size: 9px;
    margin-top: 3px;
}

/* =========================
   TABLES
========================= */

.table-panel {
    margin-top: 20px;
}

.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    color: var(--muted-2);
    text-align: left;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .07em;
    padding: 13px 18px;
    border-bottom: 1px solid var(--border);
}

td {
    padding: 15px 18px;
    border-bottom: 1px solid rgba(255,255,255,.045);
    font-size: 11px;
}

td strong {
    font-size: 11px;
}

.table-muted {
    color: var(--muted);
}

.call-result {
    color: var(--green);
    font-size: 10px;
    font-weight: 700;
}

/* =========================
   SEARCH
========================= */

.search-row {
    display: flex;
    gap: 9px;
    margin-bottom: 15px;
}

.search {
    flex: 1;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    padding: 10px 13px;
    outline: none;
    font-size: 11px;
}

.search:focus {
    border-color: rgba(61,140,255,.45);
}

.select {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    padding: 10px 13px;
    outline: none;
    font-size: 11px;
}

/* =========================
   BUTTONS
========================= */

.primary-button {
    border: 0;
    background: var(--blue);
    color: white;
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 800;
    transition: .2s ease;
}

.primary-button:hover {
    background: var(--blue-bright);
    transform: translateY(-1px);
}

.secondary-button {
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--text);
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
}

/* =========================
   AI CONTROL CENTER
========================= */

.settings-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 15px;
}

.settings-menu {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px;
    height: fit-content;
}

.settings-menu button {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--muted);
    text-align: left;
    padding: 10px;
    border-radius: 7px;
    font-size: 10px;
}

.settings-menu button.active,
.settings-menu button:hover {
    color: var(--text);
    background: var(--blue-soft);
}

.settings-content {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
}

.settings-section {
    margin-bottom: 28px;
}

.settings-section:last-child {
    margin-bottom: 0;
}

.settings-section h3 {
    font-size: 14px;
    margin-bottom: 5px;
}

.settings-section p {
    color: var(--muted);
    font-size: 10px;
    margin-bottom: 18px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 13px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    color: var(--muted);
    font-size: 9px;
    font-weight: 700;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    background: #090e16;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 8px;
    padding: 11px;
    outline: none;
    font-size: 10px;
}

.form-group textarea {
    min-height: 100px;
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: rgba(61,140,255,.45);
}

/* =========================
   PERFORMANCE
========================= */

.performance-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.progress-row {
    margin-bottom: 17px;
}

.progress-row:last-child {
    margin-bottom: 0;
}

.progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    margin-bottom: 7px;
}

.progress-label span:last-child {
    color: var(--muted);
}

.progress-bar {
    height: 6px;
    background: rgba(255,255,255,.06);
    border-radius: 99px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: var(--blue);
    border-radius: inherit;
}

/* =========================
   BILLING
========================= */

.plan-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border: 1px solid rgba(61,140,255,.2);
    background: var(--blue-soft);
    border-radius: 12px;
    margin-bottom: 15px;
}

.plan-name {
    font-size: 16px;
    font-weight: 800;
}

.plan-status {
    color: var(--green);
    font-size: 10px;
    margin-top: 5px;
}

.plan-price {
    font-size: 21px;
    font-weight: 800;
}

.plan-price span {
    color: var(--muted);
    font-size: 9px;
    font-weight: 500;
}

/* =========================
   MOBILE
========================= */

.mobile-menu {
    display: none;
}

@media (max-width: 1100px) {
    .metrics {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 800px) {
    .sidebar {
        transform: translateX(-100%);
        transition: .25s ease;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
        width: 100%;
    }

    .mobile-menu {
        display: block;
    }

    .topbar {
        padding: 0 18px;
    }

    .content {
        padding: 22px 18px 40px;
    }

    .settings-layout {
        grid-template-columns: 1fr;
    }

    .performance-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 560px) {
    .metrics {
        grid-template-columns: 1fr;
    }

    .welcome {
        display: block;
    }

    .date-label {
        margin-top: 12px;
        display: block;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .employee-stats {
        grid-template-columns: 1fr;
    }

    .page-title {
        font-size: 15px;
    }
}
</style>
</head>

<body>

<div class="app">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar" id="sidebar">

        <div class="brand">
            <div class="logo-mark"></div>
            <div class="brand-text">OFFICEWARD</div>
        </div>

        <nav class="nav">

            <div class="nav-label">WORKSPACE</div>

            <button class="nav-item active" data-view="dashboard">
                <span class="nav-icon">⌂</span>
                Dashboard
            </button>

            <button class="nav-item" data-view="appointments">
                <span class="nav-icon">▣</span>
                Appointments
            </button>

            <button class="nav-item" data-view="customers">
                <span class="nav-icon">◉</span>
                Customers
            </button>

            <button class="nav-item" data-view="leads">
                <span class="nav-icon">◇</span>
                Leads
            </button>

            <button class="nav-item" data-view="calls">
                <span class="nav-icon">◌</span>
                Calls
            </button>

            <div class="nav-label" style="margin-top:22px;">EMPLOYEE</div>

            <button class="nav-item" data-view="employee">
                <span class="nav-icon">✦</span>
                AI Employee
            </button>

            <button class="nav-item" data-view="performance">
                <span class="nav-icon">↗</span>
                Performance
            </button>

            <button class="nav-item" data-view="notifications">
                <span class="nav-icon">◔</span>
                Notifications
            </button>

            <div class="nav-label" style="margin-top:22px;">ACCOUNT</div>

            <button class="nav-item" data-view="settings">
                <span class="nav-icon">⚙</span>
                Settings
            </button>

            <button class="nav-item" data-view="billing">
                <span class="nav-icon">$</span>
                Subscription
            </button>

        </nav>

        <div class="sidebar-bottom">

            <div class="status-card">
                <div class="status-top">
                    <span class="status-dot"></span>
                    OfficeWard is online
                </div>

                <div class="status-sub">
                    AI Employee operating normally
                </div>
            </div>

            <div class="profile">
                <div class="avatar">VB</div>

                <div class="profile-info">
                    <div class="profile-name">Velocity Barber</div>
                    <div class="profile-business">Business account</div>
                </div>
            </div>

        </div>

    </aside>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="main">

        <header class="topbar">

            <div>
                <div class="page-title" id="pageTitle">
                    Dashboard
                </div>

                <div class="page-subtitle">
                    Velocity Barber
                </div>
            </div>

            <div class="top-actions">

                <button
                    class="icon-button mobile-menu"
                    id="mobileMenu">
                    ☰
                </button>

                <button class="icon-button">
                    ◔
                </button>

                <button class="icon-button">
                    ?
                </button>

            </div>

        </header>


        <div class="content">

            <!-- =========================
                 DASHBOARD
            ========================== -->

            <section class="view active" id="dashboard">

                <div class="welcome">
                    <div>
                        <h1>Good morning.</h1>
                        <p>Here's what's happening with your business.</p>
                    </div>

                    <div class="date-label">
                        SAT · SEP 5 · 2026
                    </div>
                </div>


                <div class="metrics">

                    <div class="metric">
                        <div class="metric-head">
